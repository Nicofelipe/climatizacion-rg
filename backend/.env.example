PORT=3000
HOST=127.0.0.1

DB_SERVER=localhost
DB_DATABASE=
# Sin DB_USER se usa la cuenta de Windows. En Linux son obligatorias.
DB_USER=
DB_PASSWORD=
DB_TRUST_SERVER_CERTIFICATE=true

# Mínimo 32 caracteres
JWT_SECRET=
JWT_EXPIRES_IN=8h
CORS_ALLOWED_ORIGINS=http://localhost:8081

# 32 bytes en hexadecimal. Cifra los permisos de Google Drive: si se pierde, hay que reconectar.
STORAGE_ENCRYPTION_KEY=
# drive o local
RECEIPT_STORAGE=drive
RECEIPT_STORAGE_DIR=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_LOGIN_REDIRECT_URI=
GOOGLE_LOGIN_APP_REDIRECTS=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PASSWORD_RESET_URL=

# Android FCM: keep the JSON private on the server; never copy it into mobile.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=

# Solo para crear la primera empresa y su administrador (npm run seed:admin)
COMPANY_SEED_NAME=
COMPANY_SEED_RUT=
ADMIN_SEED_FIRST_NAME=
ADMIN_SEED_LAST_NAME=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
