# Copiar a deploy/.env en el servidor (nunca subir .env a Git). setup.sh genera las claves marcadas como (auto).

# Carpeta deploy de la app Clepit que ya corre en el servidor: de ahí se leen la clave de SQL Server y su Compose.
CLEPIT_DEPLOY_DIR=/root/clepit/deploy

BOLETAS_DOMAIN=boletas.clepit.cl

# (auto) clave del usuario limitado de la base
BOLETAS_DB_PASSWORD=
# (auto) firma de las sesiones
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Debe ser LA MISMA del computador actual: con ella están cifrados los permisos de Google Drive.
STORAGE_ENCRYPTION_KEY=

# drive: Google Drive de cada empresa · local: carpeta privada del servidor
RECEIPT_STORAGE=drive

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Correo de recuperación de contraseña (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Avisos en Android (opcional). El JSON privado va en deploy/data/secrets/fcm-service-account.json
FCM_PROJECT_ID=

# Copia de respaldos fuera del servidor con rclone (recomendado, remoto cifrado)
RCLONE_REMOTE=
